# Caddyfile installed by the VPS provisioning script — see docs/DEPLOYMENT.md.
# Assumes Caddy runs on the host (not in Docker) alongside the Minecraft
# server, and the Next.js app runs in Docker bound to 127.0.0.1:3000 (see
# docker-compose.yml). Caddy handles TLS termination and automatic HTTPS
# certificate issuance/renewal.

justasimpleserver.net, www.justasimpleserver.net {
    handle /api/panel /api/panel/* {
        respond 404
    }

    # Imported service routes must use handle blocks; a loose reverse_proxy sorts after this default handler.
    import /etc/caddy/conf.d/*.caddy

    handle {
        encode gzip
        reverse_proxy 127.0.0.1:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
}
